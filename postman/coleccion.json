  "item": [
    {
      "name": "Libros (RN-01)",
      "item": [
        {
          "name": "GET libros · 200 lista con estado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es un arreglo y cada libro trae estado calculado\", () => {",
                  "  const libros = pm.response.json();",
                  "  pm.expect(libros).to.be.an(\"array\");",
                  "  libros.forEach(l => pm.expect([\"DISPONIBLE\",\"NO DISPONIBLE\"]).to.include(l.estado));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST libro válido · 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"{{isbn}}\",\n  \"titulo\": \"Pruebas de Software\",\n  \"autor\": \"Equipo QA\",\n  \"ejemplaresDisponibles\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"isbn\", \"PM-\" + Date.now());",
                  "pm.collectionVariables.set(\"dni\", String(Date.now()).slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const libro = pm.response.json();",
                  "pm.test(\"Cuerpo: id, ISBN y estado DISPONIBLE\", () => {",
                  "  pm.expect(libro.id).to.be.a(\"number\");",
                  "  pm.expect(libro.isbn).to.eql(pm.collectionVariables.get(\"isbn\"));",
                  "  pm.expect(libro.estado).to.eql(\"DISPONIBLE\");",
                  "});",
                  "pm.test(\"Header Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"libroId\", libro.id);"
                ]
              }
            }
          ]
        },
