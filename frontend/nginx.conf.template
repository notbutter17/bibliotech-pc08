server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Rutas de Angular (/libros, /prestamos) → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # El frontend consume la API por el mismo origen: nginx reenvía /api al backend.
    # Local (Compose): http://backend:8080 · Nube (Render): https://<backend>.onrender.com
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 90s;
    }
}
